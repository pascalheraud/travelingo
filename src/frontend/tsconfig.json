{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*":          ["./*"],
      "@ui/*":        ["./ui/*"],
      "@features/*":  ["./features/*"],
      "@contexts/*":  ["./contexts/*"],
      "@services":    ["./services/index.ts"],
      "@services/*":  ["./services/*"],
      "@utils/*":     ["./utils/*"]
    }
  },
  "include": ["."]
}

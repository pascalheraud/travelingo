        {
          "id": "p002",
          "source": "Vielen Dank",
          "phonetic": "mu-tschas gra-thias",
          "grammar": "« Muchas » = sehr viele (femininer Plural). « Gracias » vom Lateinischen « gratia ».",
          "complements": [
            "Einfach: « Gracias »",
            "Antwort: « De nada »"
          ]
        },
        {
          "id": "p003",
          "source": "Bitte",
          "phonetic": "por fa-wor",
          "grammar": "Wörtlich « für die Gunst ». Im Spanischen unverzichtbar, immer am Ende einer Bitte.",
          "complements": [
            "Am Anfang: « Por favor, ¿puede ayudarme? »"
          ]
        },
        {
          "id": "p004",
          "source": "Entschuldigung",
          "phonetic": "per-do-ne",
          "grammar": "Formelle Form von « perdonar » (verzeihen). Um Aufmerksamkeit zu erregen.",
          "complements": [
            "Informell: « Perdona »",
            "Starke Entschuldigung: « Lo siento mucho »"
          ]
        },
        {
          "id": "p005",
          "source": "Ich verstehe nicht",
          "phonetic": "no en-tjen-do",
          "grammar": "« Entender » vom Lateinischen « intendere ». Einfache Verneinung mit « no ».",
          "complements": [
            "Variante: « No comprendo »",
            "Bitten: « ¿Puede hablar más despacio? »"
          ]
        },
        {
          "id": "p006",
          "source": "Auf Wiedersehen",
          "phonetic": "a-djos",
          "grammar": "Wörtlich « zu Gott ». Gleiche Etymologie wie französisch « adieu ».",
          "complements": [
            "Informell: « ¡Hasta luego! »",
            "Bis bald: « ¡Hasta pronto! »"
          ]
        },
        {
          "id": "p007",
          "source": "Guten Abend / Gute Nacht",
          "phonetic": "bwenas no-tsches",
          "grammar": "Auf Spanisch dient « buenas noches » sowohl als Abendgruß ALS AUCH als Gutenacht-Formel.",
